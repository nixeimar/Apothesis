process: ald
lattice: SimpleCubic 100 100 10 X

#Random number initialization
random: 1234

#Start time in seconds - default is zero
time_start: 0

cycles: 2000

cycle: start
#The growing film
#etching: CO2

#Total time in seconds
time_duration: 18

#T in Kelvin
temperature: 1000

#P in Pascal
pressure: 101325

#Constant is a constant value in [ML/s]
#CO + * -> CO*: constant 0.4 #0.389

#Constant isa constant value in [ML/s]	
O2 + 2* -> 2O*: constant 0.2 all #0.611
		  		
#A reaction 												
CO* + O* -> CO2*: constant 1.e+5

#Time to write in log 
write: log 0.001

#Time to write the lattice heights & species
write: lattice 0.1

#Value for stopping apothesis 
#stop_coverage: O* 0.6

#Report the coverage of certain species. The time will follow the write in log file
report: coverage O* CO* X
cycle: end

cycle: start
#etching: CO2

time_start: 0
time_duration: 18
temperature: 3000
pressure: 101325

CO + * -> CO*: constant 0.2 #0.389
CO* + O* -> CO2*: constant 1.e+5

write: log 0.001
write: lattice 0.1
#stop_coverage: CO* 0.6
report: coverage O* CO* X
cycle: end
