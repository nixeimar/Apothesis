{
  "schema_version": 1,
  "description": "CO oxidation on a SimpleCubic surface",
  "system": {
    "parameters": {
      "temperature": 1000,
      "pressure": 101325,
      "custom_field": {"enabled": true, "values": [1, 2.5, "example"]}
    }
  },
  "simulation": {"start_time": 5, "duration": 500, "random_seed": 1234},
  "lattice": {
    "type": "SimpleCubic",
    "parameters": {
      "dimensions": [10, 10],
      "initial_height": 10,
      "initial_species": "X",
      "growth_species": ["CO2"]
    }
  },
  "species": {
    "X": {"parameters": {}},
    "CO": {"parameters": {"molecular_weight": 0.028}},
    "O2": {"parameters": {"molecular_weight": 0.032}},
    "O": {"parameters": {}},
    "CO2": {"parameters": {"molecular_weight": 0.044}}
  },
  "processes": [
    {
      "id": "co_adsorption",
      "type": "adsorption",
      "reactants": [{"species": "CO", "phase": "gas"}, {"vacancy": true}],
      "products": [{"species": "CO", "phase": "surface"}],
      "rate": {"model": "constant", "parameters": {"value": 0.4}},
      "parameters": {"description": "Additional model-specific data goes here"}
    },
    {
      "id": "oxygen_adsorption",
      "type": "adsorption",
      "reactants": [{"species": "O2", "phase": "gas"}, {"vacancy": true, "coefficient": 2}],
      "products": [{"species": "O", "phase": "surface", "coefficient": 2}],
      "rate": {"model": "constant", "parameters": {"value": 0.15}},
      "all_neighbors": true
    },
    {
      "id": "co_oxidation",
      "type": "reaction",
      "reactants": [{"species": "CO", "phase": "surface"}, {"species": "O", "phase": "surface"}],
      "products": [{"species": "CO2", "phase": "surface"}],
      "rate": {"model": "constant", "parameters": {"value": 1e15}}
    }
  ],
  "output": {"log_interval": 0.1, "lattice_interval": 10, "coverage": ["CO*", "O*", "X"]}
}
